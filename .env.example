# ═══════════════════════════════════════════════════════════════════════════════
# StockBuddy Environment Variables Template (.env.example)
# Copy this file to .env and customize for your environment.
# ═══════════════════════════════════════════════════════════════════════════════

# ── Server & Environment ───────────────────────────────────────────────────────
PORT=5000
HOST=0.0.0.0
ENVIRONMENT=production          # development | staging | production
LOG_FORMAT=json                 # text | json
DEBUG=false
SECURITY_HEADERS_ENABLED=true

# ── Error Tracking & Telemetry ─────────────────────────────────────────────────
SENTRY_DSN=                     # e.g., https://xxx@o123.ingest.sentry.io/456

# ── Quantitative & ML Configuration ───────────────────────────────────────────
SB_DEFAULT_TICKER=AAPL
SB_DEFAULT_START_DATE=2020-01-01
SB_SEQUENCE_LENGTH=90
SB_EPOCHS=20
SB_BATCH_SIZE=16
SB_LEARNING_RATE=0.0001

# ── Backtest & Risk Parameters ─────────────────────────────────────────────────
SB_INITIAL_CAPITAL=10000.0
SB_RISK_FREE_RATE_ANNUAL=0.05
SB_TRANSACTION_COST_PCT=0.001

# ── Distributed Systems & Circuit Breaker ──────────────────────────────────────
SB_FETCH_PARALLELISM=4
SB_CB_FAILURE_THRESHOLD=0.5
SB_CB_WINDOW_SIZE=20
SB_CB_RESET_TIMEOUT_S=60.0

# ── Rate Limiter Parameters ───────────────────────────────────────────────────
SB_RATE_LIMIT_BURST=20.0
SB_RATE_LIMIT_RATE=5.0
SB_RATE_LIMIT_WINDOW_MAX=30
SB_RATE_LIMIT_WINDOW_S=60.0

# ── Background Worker & Storage ───────────────────────────────────────────────
SB_MAX_WORKER_THREADS=4
SB_MODEL_ARTIFACTS_DIR=model_artifacts
SB_INFERENCE_CACHE_TTL_S=3600
SB_MODEL_STALE_DAYS=7

# ── Authentication ─────────────────────────────────────────────────────────────
# REQUIRED in production — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SB_JWT_SECRET=                  # e.g., a64f2c...  (64 hex chars)
