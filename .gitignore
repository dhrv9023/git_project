# ─── Phase 2: ML Runtime Artifacts ───────────────────────────────────────────
# Model weights, scalers, and registry are generated at runtime by ModelStore
# and ModelRegistry. They should NOT be committed — models can be multi-GB
# and must be retrained per environment.
model_artifacts/

# Pickle files (inference cache, scikit-learn scalers outside model_artifacts/)
*.pkl

